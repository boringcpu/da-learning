def expected_cost_curve(
    y_true,
    y_score,
    c_fn=1,
    c_fp=1
):

    thresholds = np.linspace(0, 1, 100)

    costs = []

    # 正反例比例
    p_positive = np.mean(y_true == 1)
    p_negative = np.mean(y_true == 0)


    for threshold in thresholds:

        y_pred = (y_score >= threshold).astype(int)

        tn, fp, fn, tp = confusion_matrix(
            y_true,
            y_pred
        ).ravel()


        # 假反例率
        fnr = fn / (fn + tp)

        # 假正例率
        fpr = fp / (fp + tn)


        # 西瓜书期望总体代价
        ec = (
            p_positive * fnr * c_fn
            +
            p_negative * fpr * c_fp
        )

        costs.append(ec)


    return thresholds, costs



